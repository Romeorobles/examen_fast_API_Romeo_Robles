{
  "info": {
    "name": "Gimnasio — Planes de Membresía",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden con el servidor recién arrancado (datos en memoria)."
