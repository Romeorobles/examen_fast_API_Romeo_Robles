    {
      "name": "Pregunta 3 — Socio",
      "item": [
        {
          "name": "Socio con contratados (minúsculas) [200]",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/membresias/socio?contratados=bas101&contratados=ELI401",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "membresias",
                "socio"
              ],
              "query": [
                {
                  "key": "contratados",
                  "value": "bas101"
                },
                {
                  "key": "contratados",
                  "value": "ELI401"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"total = 6\", () => pm.expect(pm.response.json()[\"total\"]).to.eql(6));",
                  "pm.test(\"contratados = 2\", () => pm.expect(pm.response.json()[\"contratados\"]).to.eql(2));",
                  "pm.test(\"disponibles = 4\", () => pm.expect(pm.response.json()[\"disponibles\"]).to.eql(4));",
                  "pm.test(\"porcentaje_contratacion = 33.3\", () => pm.expect(pm.response.json()[\"porcentaje_contratacion\"]).to.eql(33.3));",
                  "pm.test(\"ingreso_potencial_disponibles = 195\", () => pm.expect(pm.response.json()[\"ingreso_potencial_disponibles\"]).to.eql(195));",
                  "pm.test(\"plan_disponible_mas_caro = \"PRE301\"\", () => pm.expect(pm.response.json()[\"plan_disponible_mas_caro\"]).to.eql(\"PRE301\"));"
                ]
              }
            }
          ]
        }
      ]
