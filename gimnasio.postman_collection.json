  "item": [
    {
      "name": "Pregunta 2 — Facturación",
      "item": [
        {
          "name": "Facturación nivel 2, 12 meses (descuento) [200]",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/membresias/facturacion?meses=12&nivel=2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "membresias",
                "facturacion"
              ],
              "query": [
                {
                  "key": "meses",
                  "value": "12"
                },
                {
                  "key": "nivel",
                  "value": "2"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"planes = 2\", () => pm.expect(pm.response.json()[\"planes\"]).to.eql(2));",
                  "pm.test(\"meses = 12\", () => pm.expect(pm.response.json()[\"meses\"]).to.eql(12));",
                  "pm.test(\"precio_promedio = 47.5\", () => pm.expect(pm.response.json()[\"precio_promedio\"]).to.eql(47.5));",
                  "pm.test(\"facturacion_base = 1140\", () => pm.expect(pm.response.json()[\"facturacion_base\"]).to.eql(1140));",
                  "pm.test(\"descuento_aplicado = true\", () => pm.expect(pm.response.json()[\"descuento_aplicado\"]).to.eql(true));",
                  "pm.test(\"facturacion_estimada = 969.0\", () => pm.expect(pm.response.json()[\"facturacion_estimada\"]).to.eql(969.0));",
                  "pm.test(\"porcentaje_con_entrenador = 50.0\", () => pm.expect(pm.response.json()[\"porcentaje_con_entrenador\"]).to.eql(50.0));"
                ]
              }
            }
          ]
        },
